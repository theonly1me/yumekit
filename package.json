{
  "name": "yumekit",
  "version": "0.1.0",
  "private": true,
  "description": "The open source video harness for AI agents. Reels, explainers, trailers, and films with one story, one cast, and one look in every shot.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@12.21.0+sha512.66fd8278ee28935ce951792d34367ff3af5c432a2756445823029533835b8da529bbe0be5130afd56ed0713fb8789e47bad82d93bd5ae2fe54b15562d6276ef0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc --build && pnpm --filter @yumekit/editor run build",
    "typecheck": "tsc --build && tsc -p scripts/importRules && tsc -p scripts/release && tsc -p scripts/testFolders",
    "lint": "eslint . && prettier --check . && pnpm run check-imports",
    "check-imports": "node --experimental-strip-types scripts/importRules/checkImports.ts",
    "test": "node --experimental-strip-types scripts/testFolders/main.ts",
    "format": "prettier --write .",
    "pack-release": "tsc --build --clean && pnpm build && node --experimental-strip-types scripts/release/packRelease.ts",
    "check-release": "node --experimental-strip-types scripts/release/installCheck/main.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.1"
  }
}
